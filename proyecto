# MATRIZ DE PRODUCTOS
menu = [
    ["Hamburguesa Gourmet", "Comida", 15000],
    ["Papas Fritas", "Acompañamiento", 5000],
    ["Pizza Familiar", "Comida", 25000],
    ["Jugo Natural", "Bebida", 6000],
    ["Torta de Chocolate", "Postre", 8500],
    ["Malteada Premium", "Bebida", 12000]
]

# FUNCIÓN PARA CALCULAR EL PRECIO FINAL
def calcular_precio_final(producto, categoria_objetivo, umbral_precio):
    categoria = producto[1]
    precio_base = producto[2]

    if categoria == categoria_objetivo and precio_base > umbral_precio:
        descuento = precio_base * 0.15
        return precio_base - descuento
    
    return precio_base

# MOSTRAR LA SALIDA
def aplicar_promocion_al_menu(matriz_menu, categoria_promo, umbral_promo):
    print(f"--- PROMO: 15% de desc. en '{categoria_promo}' mayores a ${umbral_promo} ---")
    print("-" * 70)

    for producto in matriz_menu:
        nombre = producto[0]
        precio_base = producto[2]
        precio_final = calcular_precio_final(producto, categoria_promo, umbral_promo)
        print(f"Producto: {nombre:<22} | Precio Base: ${precio_base:<6} | Precio Final: ${precio_final:.0f}")

# EJECUCIÓN
CATEGORIA_OBJETIVO = "Comida"
UMBRAL_PRECIO = 10000

aplicar_promocion_al_menu(menu, CATEGORIA_OBJETIVO, UMBRAL_PRECIO)